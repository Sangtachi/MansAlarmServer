NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Bearer for Vercel Cron hitting /api/cron/* (Authorization: Bearer <CRON_SECRET> or x-cron-secret).
# In Vercel, set CRON_SECRET in Project Env — Vercel Cron sends Authorization: Bearer automatically.
# Cron handlers log one JSON line per request (job, level, …) for log drains / failure alerts.
CRON_SECRET=YOUR_LONG_RANDOM_SECRET
# Daily seed cron backfills today + N-1 days so a missed cron run does not leave the app empty.
DAILY_CONTENT_SEED_DAYS=7
CONTENT_GENERATOR_BACKEND=deterministic
OLLAMA_BASE_URL=http://127.0.0.1:11434/api
OLLAMA_MODEL=your_ollama_model_name
OLLAMA_MODEL_CANDIDATES=llama3.1:latest,qwen2.5-coder:7b
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TIMEOUT_MS=90000
OLLAMA_REPAIR_RETRIES=1
YOUTUBE_CLIENT_ID=YOUR_YOUTUBE_CLIENT_ID
YOUTUBE_CLIENT_SECRET=YOUR_YOUTUBE_CLIENT_SECRET
YOUTUBE_REFRESH_TOKEN=YOUR_YOUTUBE_REFRESH_TOKEN
YOUTUBE_CHANNEL_ID=YOUR_YOUTUBE_CHANNEL_ID
INSTAGRAM_APP_ID=YOUR_INSTAGRAM_APP_ID
INSTAGRAM_APP_SECRET=YOUR_INSTAGRAM_APP_SECRET
INSTAGRAM_ACCESS_TOKEN=YOUR_INSTAGRAM_ACCESS_TOKEN
INSTAGRAM_BUSINESS_ID=YOUR_INSTAGRAM_BUSINESS_ID
RENDER_WORKER_URL=https://your-render-worker.example.com
RENDER_WORKER_SECRET=YOUR_RENDER_WORKER_SECRET
